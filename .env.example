# Runtime
ENVIRONMENT=development

# LLM
LLM_API_KEY=replace-me
LLM_API_BASE=https://api.example.com/v1
LLM_MODEL=replace-me

# Authentication
# Production: use at least 32 random characters and never commit the real value.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=fashion-agent
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Only used by scripts/seed_data.py for local demo accounts.
SEED_CUSTOMER_PASSWORD=replace-me
SEED_SERVICE_PASSWORD=replace-me
SEED_SUPERVISOR_PASSWORD=replace-me
SEED_ADMIN_PASSWORD=replace-me
SEED_DEVELOPER_PASSWORD=replace-me

# Demo store member mapping (development only; no browser identity input).
DEMO_STORE_TENANT_ID=1
DEMO_STORE_USER_ID=1

# Refund Demo: mock is development-only and never moves real money.
REFUND_GATEWAY_MODE=mock
MOCK_REFUND_RESULT=succeeded
# Comma-separated order IDs that override the default result to failed.
MOCK_REFUND_FAILED_ORDER_IDS=10002

# Pending slot state lifetime (minutes).
CONVERSATION_STATE_TTL_MINUTES=30
